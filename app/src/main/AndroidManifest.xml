<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".VanRakshakApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VanRakshak">

        <!-- Splash Screen Activity (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VanRakshak">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activity (Login / Register) -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.VanRakshak"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.VanRakshak"
            android:windowSoftInputMode="adjustResize" />

        <!-- GeoMonitor Shared Map Activity -->
        <activity
            android:name=".ui.geomonitor.GeoMonitorActivity"
            android:exported="false"
            android:label="VanRakshak GeoMonitor Map"
            android:theme="@style/Theme.VanRakshak" />

    </application>

</manifest>
