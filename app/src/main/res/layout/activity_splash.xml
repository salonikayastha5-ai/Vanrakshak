<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_nature"
    tools:context=".ui.splash.SplashActivity">

    <!-- Center Section: Emblem, App Title & Tagline -->
    <LinearLayout
        android:id="@+id/layoutCenterBrand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Forest Emblem Logo -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_forest_emblem" />

        <!-- Application Title -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:letterSpacing="0.15"
            android:text="@string/app_name_uppercase"
            android:textColor="@color/text_on_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:letterSpacing="0.03"
            android:text="@string/splash_tagline"
            android:textColor="@color/forest_green_primary_container"
            android:textSize="15sp"
            android:textStyle="normal" />

    </LinearLayout>

    <!-- Bottom Section: Loading Indicator & Subtitle -->
    <LinearLayout
        android:id="@+id/layoutBottomSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xlarge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Subtle Circular Progress Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/splashProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/forest_green_primary_container"
            app:indicatorSize="24dp"
            app:trackColor="#20FFFFFF"
            app:trackThickness="3dp" />

        <!-- Footer AI Description -->
        <TextView
            android:id="@+id/tvSplashFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:letterSpacing="0.12"
            android:text="@string/splash_footer_ai_monitoring"
            android:textColor="@color/forest_green_primary_container"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
